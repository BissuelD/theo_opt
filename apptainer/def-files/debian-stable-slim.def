Bootstrap: docker
From: debian:stable-slim


%files
    /home/dbissuel/Documents/ILM/MMCI/Stefan/theo_opt /opt/theo_opt

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 \
        python3-tk \
        python3-numpy \
        python3-scipy \
        python3-matplotlib \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-fonts-recommended \
        texlive-fonts-extra \
        dbus \
        dbus-x11 \
        x11-utils \
        dvipng \
        texlive-latex-extra \
        texlive-fonts-recommended \
        cm-super
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    
    # Set up DBus machine-id
    mkdir -p /etc
    dbus-uuidgen > /etc/machine-id
    chmod 644 /etc/machine-id
    
    # Create runtime directory
    mkdir -p /run/user/1001
    chmod 700 /run/user/1001

%environment
    export PYTHONUNBUFFERED=1
    export XDG_RUNTIME_DIR=/run/user/1001
    export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
    export PYTHONPATH=/opt/theo_opt:$PYTHONPATH
    export PATH=/opt/theo_opt/bin:$PATH

%runscript
    python3 /opt/theo_opt/launcher.py
